{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-studio.local/schemas/project.schema.json",
  "title": "ProjectConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "mode",
    "canonical_entry",
    "compiler_profile",
    "classification",
    "revision",
    "tracked_files",
    "created_at_utc",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mode": { "type": "string", "enum": ["latex_first", "typst_first"] },
    "canonical_entry": { "type": "string", "minLength": 1 },
    "compiler_profile": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "string",
      "enum": ["Public", "Internal", "Confidential", "Restricted"]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "tracked_files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "updated_at_utc": { "type": "string", "minLength": 1 }
  }
}
