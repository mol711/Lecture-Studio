{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-studio.local/schemas/workspace.schema.json",
  "title": "WorkspaceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "created_at_utc",
    "allowed_input_roots",
    "allowed_output_roots"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "allowed_input_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_output_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "retention_policy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_snapshot_count": { "type": ["integer", "null"], "minimum": 1 },
        "retention_days": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
